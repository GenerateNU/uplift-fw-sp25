 145:main.c        ****         // Play the note for its duration
 146:main.c        ****         CyDelay(*durations[i]);
 147:main.c        ****     }
 148:main.c        ****     
 149:main.c        ****     // Stop the PWM after playing all notes
 150:main.c        ****     //BUZZER_PWM_0_Stop();
 151:main.c        **** }
