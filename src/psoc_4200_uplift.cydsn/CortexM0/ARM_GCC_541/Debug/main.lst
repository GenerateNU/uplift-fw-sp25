 135:main.c        ****  * @param notes Array of frequency values in Hz (0 for a rest)
 136:main.c        ****  * @param durations Array of note durations in milliseconds
 137:main.c        ****  * @param count Number of notes in the arrays
 138:main.c        ****  */
 139:main.c        **** void Play_Melody(const uint16_t *notes[], const uint16_t *durations[], uint16_t count) {
 140:main.c        ****     for (uint16_t i = 0; i < count; i++) {
 141:main.c        ****         // Set the frequency for the current note
 142:main.c        ****         volatile int n = ((1/ (*notes[i]))*1000);
 143:main.c        ****         BUZZER_PWM_0_WritePeriod(n);
 144:main.c        ****         
